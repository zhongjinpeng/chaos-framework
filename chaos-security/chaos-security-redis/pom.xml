<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.michael</groupId>
        <artifactId>chaos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>chaos-security-redis</artifactId>
    <name>chaos-security-redis</name>
    <description>
        Redis adapters for the security domain: the single JWT revocation (blacklist) implementation shared by
        authorization server, resource servers and gateway, plus Redis-backed authorization server stores
        (authorization, registered client, consent, session registry, kickout, captcha, login lock).
    </description>
    <dependencies>
        <!-- StaleValueReader 丢弃不兼容存量数据时要留痕，否则"令牌悄悄失效"无从排查。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-security-api</artifactId>
        </dependency>
        <!-- 授权服务器存储实现只在引入 chaos-authorization 的应用中使用；资源服务器/网关只用黑名单实现。 -->
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-authorization</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-audit</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- RedisAuthorizationPolicySource 解析策略 JSON 时使用。 -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>chaos-integration-test</id>
            <dependencies>
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-boot-starter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
