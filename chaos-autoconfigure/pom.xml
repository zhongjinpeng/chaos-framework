    <artifactId>chaos-autoconfigure</artifactId>
    <name>chaos-autoconfigure</name>
    <description>Single auto-configuration module for all Chaos features; starters add the feature libraries.</description>
    <!--
        全部 chaos 自动装配集中在本模块（参照 spring-boot-autoconfigure 的做法）：
        - 功能库与三方框架一律 optional，业务方通过 chaos-*-starter 按需引入；
        - 每个 @AutoConfiguration 必须以 @ConditionalOnClass 声明其依赖的功能库与框架，
          引用可选类型的 @Bean 方法放入带 @ConditionalOnClass 的嵌套配置类，避免类加载失败；
        - 库模块不得反向依赖本模块。
    -->
    <dependencies>
        <!-- 自动装配运行所需的最小依赖；其余全部 optional，由各 starter 负责带入。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- chaos-core 纯 Java、无三方依赖：生产安全检查与启动诊断使用其中的 ChaosDiagnostic，必须始终存在。 -->
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-core</artifactId>
        </dependency>

        <!-- chaos 功能库：optional，每个自动装配以 @ConditionalOnClass 感知其是否存在。 -->
