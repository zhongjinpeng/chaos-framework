            <groupId>com.michael</groupId>
            <artifactId>chaos-audit</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-audit-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-authorization</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-storage</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
