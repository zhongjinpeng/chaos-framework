{
  "hints": [
    {
      "name": "chaos.gateway.token.type",
      "values": [
        {
          "value": "jwt",
          "description": "JWT 自包含 token：网关本地验签，需要 chaos.gateway.jwt.jwk-set-uri。"
        },
        {
          "value": "opaque",
          "description": "opaque/reference token：网关通过 chaos.gateway.opaque-token.introspection-uri 远程校验（带缓存与超时）。"
        }
      ]
    },
    {
      "name": "chaos.gateway.rate-limit.key-types",
      "values": [
        {
          "value": "route",
          "description": "按 Gateway routeId 限流。"
        },
        {
          "value": "path",
          "description": "按请求路径限流。"
        },
        {
          "value": "ip",
          "description": "按客户端 IP 限流（部署在代理之后时必须配置 chaos.gateway.trusted-proxies）。"
        },
        {
          "value": "user",
          "description": "按用户 ID 限流。"
        },
        {
          "value": "tenant",
          "description": "按租户 ID 限流。"
        }
      ]
    },
    {
      "name": "chaos.gateway.jwt.jws-algorithms",
      "values": [
        {
          "value": "RS256",
          "description": "RSA SHA-256（默认，与 chaos-authorization 签发算法一致）。"
        },
        {
          "value": "RS384",
          "description": "RSA SHA-384。"
        },
        {
          "value": "RS512",
          "description": "RSA SHA-512。"
        },
        {
          "value": "ES256",
          "description": "ECDSA P-256 SHA-256。"
        },
        {
          "value": "PS256",
          "description": "RSASSA-PSS SHA-256。"
        }
      ]
    },
    {
      "name": "chaos.gateway.internal-headers",
      "values": [
        {
          "value": "X-User-Id",
          "description": "用户 ID（默认剥离）。"
        },
        {
          "value": "X-Tenant-Id",
          "description": "租户 ID（默认剥离）。"
        }
      ]
    },
    {
      "name": "chaos.gateway.trusted-proxies",
      "values": [
        {
          "value": "10.0.0.0/8",
          "description": "私有网段 A（常见 K8s / VPC 内网 LB）。"
        },
        {
          "value": "172.16.0.0/12",
          "description": "私有网段 B。"
        },
        {
          "value": "192.168.0.0/16",
          "description": "私有网段 C。"
        },
        {
          "value": "127.0.0.1/32",
          "description": "本机反向代理。"
        }
      ]
    },
    {
      "name": "chaos.gateway.access.combining-algorithm",
      "values": [
        {
          "value": "deny-overrides",
          "description": "拒绝优先：任一配置策略 DENY 即拒绝（默认）。"
        },
        {
          "value": "allow-overrides",
          "description": "允许优先：任一配置策略 ALLOW 即放行。"
        },
        {
          "value": "first-applicable",
          "description": "首个适用策略生效。"
        }
      ]
    },
    {
      "name": "chaos.gateway.access.rules[].methods",
      "values": [
        {
          "value": "GET",
          "description": "只对 GET 生效。"
        },
        {
          "value": "POST",
          "description": "只对 POST 生效。"
        },
        {
          "value": "PUT",
          "description": "只对 PUT 生效。"
        },
        {
          "value": "DELETE",
          "description": "只对 DELETE 生效。"
        }
      ],
      "providers": [
        {
          "name": "any"
        }
      ]
    },
    {
      "name": "chaos.gateway.access.policies[].conditions[].left",
      "values": [
        {
          "value": "subject.userId",
          "description": "token 中的用户 ID。"
        },
        {
          "value": "subject.tenantId",
          "description": "token 中的租户 ID。"
        },
        {
          "value": "subject.roles",
          "description": "token 中的角色集合，配合 IN / CONTAINS 使用。"
        },
        {
          "value": "environment.clientIp",
          "description": "按可信代理解析后的客户端 IP。"
        },
        {
          "value": "environment.http.method",
          "description": "HTTP 方法。"
        },
        {
          "value": "environment.http.path",
          "description": "请求路径。"
        }
      ],
      "providers": [
        {
          "name": "any"
        }
      ]
    }
  ]
