<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        chaos-parent 以公共 BOM chaos-dependencies 为 parent：
        - 依赖版本（Spring Boot / Spring Cloud / 三方库 / 框架自身模块）只在 chaos-dependencies 中维护一份；
        - 本 POM 只负责构建插件、质量门禁和发布 profile。
        版本号统一为 ${revision}，默认值位于 .mvn/maven.config。
    -->
    <parent>
        <groupId>com.michael</groupId>
        <artifactId>chaos-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>chaos-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>chaos-parent</artifactId>
    <packaging>pom</packaging>

    <name>chaos-framework</name>
    <description>Enterprise Spring Boot and Spring Cloud framework based on DDD and Hexagonal Architecture.</description>

    <modules>
        <module>chaos-dependencies</module>
        <module>chaos-boot-parent</module>
        <module>chaos-foundation</module>
        <module>chaos-observability</module>
        <module>chaos-audit</module>
        <module>chaos-tenant</module>
        <module>chaos-security</module>
        <module>chaos-web</module>
        <module>chaos-data</module>
        <module>chaos-mq</module>
        <module>chaos-service</module>
        <module>chaos-gateway</module>
        <module>chaos-job</module>
        <module>chaos-storage</module>
        <module>chaos-test-support</module>
        <module>chaos-architecture-tests</module>
        <module>chaos-autoconfigure</module>
        <module>chaos-starters</module>
        <module>chaos-archetypes</module>
        <module>chaos-examples</module>
        <module>chaos-docs</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
        <japicmp-maven-plugin.version>0.26.2</japicmp-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <maven-archetype-plugin.version>3.4.1</maven-archetype-plugin.version>

        <!--
            API 兼容检查：默认对比上一个已发布版本；基线不存在时跳过而不是失败。
            按语义化版本判定：PATCH 不允许任何 API 变化，MINOR 只允许兼容新增，MAJOR 允许不兼容变更。
            1.0.0 是首个对外发布版本，没有可比基线，因此留空并跳过检查；
            发布 1.0.1 及之后的版本时，把 compareVersion 设为上一个已发布版本并把 skip 改回 false。
        -->
        <chaos.api.check.skip>true</chaos.api.check.skip>
        <chaos.release.compareVersion>1.0.0</chaos.release.compareVersion>
        <gpg.skip>true</gpg.skip>
        <!-- 覆盖率门槛：先以报告为主，门槛可在 CI 中通过 -Dchaos.coverage.minimum 提高。 -->
        <chaos.coverage.minimum>0.00</chaos.coverage.minimum>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <showWarnings>true</showWarnings>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-java-and-maven</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireJavaVersion>
                                        <version>[21,22)</version>
                                    </requireJavaVersion>
                                    <requireMavenVersion>
                                        <version>[3.9.0,)</version>
                                    </requireMavenVersion>
                                    <!-- 依赖收敛在每次构建时都执行，release profile 不再重复执行。 -->
                                    <dependencyConvergence/>
                                    <!--
                                      已知存在无法修复的严重漏洞、或已被 Spring Boot 托管依赖取代的坐标。
                                      CodeQL 只扫描本仓库源码，不看依赖的 CVE，这里补上最基本的一道闸。
                                    -->
                                    <bannedDependencies>
                                        <excludes>
                                            <exclude>log4j:log4j</exclude>
                                            <exclude>org.apache.logging.log4j:log4j-core:(,2.17.1)</exclude>
                                            <exclude>commons-collections:commons-collections</exclude>
                                            <exclude>commons-beanutils:commons-beanutils:(,1.9.4)</exclude>
                                            <exclude>org.codehaus.jackson:*</exclude>
                                            <exclude>com.fasterxml.jackson.core:jackson-databind:(,2.13.4.2)</exclude>
                                            <exclude>junit:junit</exclude>
                                            <exclude>org.springframework:spring-core:(,6.0.0)</exclude>
                                        </excludes>
                                        <searchTransitive>true</searchTransitive>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                        <updatePomFile>true</updatePomFile>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <!--
                            现有中文注释中存在大量未转义的 HTML 片段，直接开启 doclint 会阻断发布。
                            修复全部注释后可改为 all,-missing；在此之前保持 none，并通过 CI 的 javadoc 构建发现回归。
                        -->
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                    <configuration>
                        <skip>${gpg.skip}</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- SBOM：发布到 Maven Central 时随构件附带 CycloneDX 物料清单。 -->
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                    <configuration>
                        <projectType>library</projectType>
                        <schemaVersion>1.5</schemaVersion>
                        <outputName>${project.artifactId}-${project.version}-cyclonedx</outputName>
                        <includeTestScope>false</includeTestScope>
                        <!--
                          发布走 central-publishing-maven-plugin 而不是 maven-deploy，后者被置为 skip，
                          cyclonedx 默认的 skipNotDeployed 会据此跳过所有模块，一个 SBOM 都产不出来。
                        -->
                        <skipNotDeployed>false</skipNotDeployed>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                    <configuration>
                        <skip>${chaos.api.check.skip}</skip>
                        <oldVersion>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${chaos.release.compareVersion}</version>
                                <type>jar</type>
                            </dependency>
                        </oldVersion>
                        <newVersion>
                            <file>
                                <path>${project.build.directory}/${project.build.finalName}.jar</path>
                            </file>
                        </newVersion>
                        <parameter>
                            <onlyModified>true</onlyModified>
                            <!-- 以版本号语义决定是否阻断：MAJOR 升级允许不兼容变更，同一大版本内的 PATCH/MINOR 仍会拦截破坏性修改。 -->
                            <breakBuildBasedOnSemanticVersioning>true</breakBuildBasedOnSemanticVersioning>
                            <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            <includeSynthetic>false</includeSynthetic>
                            <!-- 基线版本未发布（新模块或首次发布）时跳过，不阻断构建。 -->
                            <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                            <skipPomModules>true</skipPomModules>
                        </parameter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <!-- ${revision} 在 install/deploy 出去的 POM 中必须被替换成真实版本，否则下游无法解析 parent。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>chaos-integration-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-integration-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/integration-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-integration-test-resource</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>add-test-resource</goal>
                                </goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>src/integration-test/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/*IT.java</include>
                                    </includes>
                                    <useModulePath>false</useModulePath>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- 覆盖率报告：./mvnw -Pchaos-coverage verify，报告位于各模块 target/site/jacoco。 -->
            <id>chaos-coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <haltOnFailure>true</haltOnFailure>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${chaos.coverage.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>chaos-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-release-plugin-versions</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <!-- dependencyConvergence 已在默认构建中执行，这里只追加发布专属规则。 -->
                                        <requirePluginVersions/>
                                    </rules>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- 发布到 Maven Central 前必须替换 chaos-dependencies 中的 CHANGE-ME 元数据占位值。 -->
                                <id>enforce-release-metadata</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>chaos.project.url</property>
                                            <regex>^(?!.*CHANGE-ME).+$</regex>
                                            <regexMessage>发布前必须设置 chaos.project.url</regexMessage>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>chaos.scm.connection</property>
                                            <regex>^(?!.*CHANGE-ME).+$</regex>
                                            <regexMessage>发布前必须设置 chaos.scm.connection</regexMessage>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>chaos.license.name</property>
                                            <regex>^(?!.*CHANGE-ME).+$</regex>
                                            <regexMessage>发布前必须设置 chaos.license.name</regexMessage>
                                        </requireProperty>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <!-- makeBom 而不是 makeAggregateBom：发布到 Central 的是一批独立构件，
                                     每个构件应带自己的物料清单；聚合清单只在根模块产出，下游拿不到。 -->
                                <id>attach-sbom</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- 按语义化版本在 verify 阶段检查 API 兼容性：同一大版本内的不兼容变更阻断发布，大版本升级自动放行。 -->
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>api-compatibility-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Maven Central Portal 发布；autoPublish=false，需在 Portal 上人工确认后发布。 -->
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
