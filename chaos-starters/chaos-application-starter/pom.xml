<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.michael</groupId>
        <artifactId>chaos-starters</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>chaos-application-starter</artifactId>
    <name>chaos-application-starter</name>
    <description>Application-layer starter: transactions, retry, domain events, context propagation and metrics.</description>
    <!--
        application-starter 只聚合应用层能力：事务、重试、领域事件、上下文传播、指标。
        改名原因：旧名容易被理解成“业务服务全家桶”，与场景 starter chaos-web-service-starter 混淆。
        - Web 业务服务：直接使用 chaos-web-service-starter（已包含本 starter）；
        - 纯 MQ 消费者、批处理等非 Web 服务：单独引入本 starter，再按需追加 mq/job/mybatis 等能力 starter。
    -->
    <dependencies>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>
</project>
