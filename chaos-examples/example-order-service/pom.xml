<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.michael</groupId>
        <artifactId>chaos-examples</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>example-order-service</artifactId>
    <name>example-order-service</name>
    <dependencies>
        <!-- 场景 starter：Servlet 业务服务（web + security + tenant + audit + trace + application）。 -->
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-web-service-starter</artifactId>
        </dependency>
        <!-- 能力 starter：按需追加。 -->
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-mybatis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-mq-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-cloud-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.michael</groupId>
            <artifactId>chaos-cloud-nacos-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <!-- 生成可执行 fat jar，smoke 脚本通过 java -jar 启动示例服务。 -->
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
