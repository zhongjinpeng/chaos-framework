<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Chaos 公共 BOM，也是整个工程依赖版本的唯一来源。

        设计说明：
        1. 本 POM 不继承任何父 POM，发布后业务方 import 时只会拿到依赖版本，不会带入框架自身的构建插件配置。
        2. chaos-parent（根 pom.xml）反过来以本 POM 为 parent，框架内部模块与业务方共用同一份版本定义，
           避免根 POM 与 BOM 各维护一份清单导致漂移。
        3. 版本号统一使用 CI friendly 的 ${revision}，默认值定义在 .mvn/maven.config，
           install/deploy 时由 flatten-maven-plugin 替换为真实版本。
        4. 新增对外模块时必须同步在这里登记，chaos-architecture-tests 中的架构测试会双向校验：
           BOM 不得缺少真实模块，也不得声明仓库里不存在的模块。
    -->
    <groupId>com.michael</groupId>
    <artifactId>chaos-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>chaos-dependencies</name>
    <description>Public BOM for Chaos Framework consumers.</description>
    <url>${chaos.project.url}</url>

    <!-- 发布到 Maven Central 必需的元数据。占位值会在 chaos-release profile 的 deploy 阶段被 enforcer 拦截。 -->
    <licenses>
        <license>
            <name>${chaos.license.name}</name>
            <url>${chaos.license.url}</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>michael</id>
            <name>michael</name>
            <email>jpzhong19941212@outlook.com</email>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>${chaos.project.url}</url>
        <connection>${chaos.scm.connection}</connection>
        <developerConnection>${chaos.scm.connection}</developerConnection>
    </scm>

    <properties>
        <!-- 发布元数据：许可证与 chaos-python 保持一致（Apache-2.0）；仓库地址发布前通过 -D 或修改此处替换 CHANGE-ME 占位值。 -->
        <chaos.project.url>https://CHANGE-ME/chaos</chaos.project.url>
        <chaos.scm.connection>scm:git:https://CHANGE-ME/chaos.git</chaos.scm.connection>
        <chaos.license.name>Apache License, Version 2.0</chaos.license.name>
        <chaos.license.url>https://www.apache.org/licenses/LICENSE-2.0.txt</chaos.license.url>

        <!-- Spring Cloud 2025.0.x 与 Spring Boot 3.5.x 对齐；Spring Cloud Alibaba 2025.0.0.0 适配同一代。 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
        <testcontainers.version>1.21.4</testcontainers.version>

        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <redisson.version>3.50.0</redisson.version>
        <springdoc.version>2.8.14</springdoc.version>
        <logstash-logback.version>8.1</logstash-logback.version>
        <jjwt.version>0.13.0</jjwt.version>
        <minio.version>8.6.0</minio.version>
        <aliyun-oss.version>3.18.3</aliyun-oss.version>
        <rocketmq-spring.version>2.3.3</rocketmq-spring.version>
        <!-- nimbus-jose-jwt 与 oauth2-oidc-sdk 必须成对升级，否则 dependencyConvergence 会失败。 -->
        <nimbus-jose-jwt.version>9.47</nimbus-jose-jwt.version>
        <oauth2-oidc-sdk.version>11.23.1</oauth2-oidc-sdk.version>

        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 框架直接使用、但 Spring Boot / Spring Cloud BOM 未管理的三方库。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>oauth2-oidc-sdk</artifactId>
                <version>${oauth2-oidc-sdk.version}</version>
            </dependency>
            <!-- 基础库模块 -->
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- chaos-core 的测试替身（RecordingChaosMetrics 等），仅供框架内部模块以 test 作用域复用。 -->
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-core</artifactId>
                <version>${revision}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-domain</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-trace</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-audit</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-audit-jdbc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-tenant</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-security-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-security-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-authorization</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-service</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mq</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mq-jdbc</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mq-kafka</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mq-rocketmq</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-gateway</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-gateway-nacos</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-job</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-storage</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-storage-minio</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-storage-oss</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 统一自动装配模块：业务方通常不直接依赖，优先使用对应 starter。 -->
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-autoconfigure</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 测试支持：使用方以 test scope 引入 -->
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-test-support</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 场景 starter：按要搭建的服务类型选择一个 -->
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-web-service-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-auth-server-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 能力 starter：按需追加（chaos-gateway-starter 同时是网关场景 starter） -->
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-audit-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-audit-jdbc-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-authorization-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-cloud-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-cloud-nacos-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-cloud-reactive-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-gateway-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-gateway-nacos-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-job-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mq-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-mybatis-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-redis-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-security-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-application-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-storage-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-tenant-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.michael</groupId>
                <artifactId>chaos-web-starter</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                本 POM 无 parent，需要自行绑定 flatten，保证安装/发布出去的 BOM 中 ${revision} 已被替换。
                inherited=false：chaos-boot-parent 以本 POM 为 parent，业务应用不应继承框架发布用的 flatten 执行；
                chaos-parent 自己声明了 flatten，不受影响。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
